# Copy to .env. Never commit real values. Use long random hex strings.
SECRET_KEY=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-with-random-hex-password
# TMDB API Read Access Token (not the shorter API key).
TMDB_READ_TOKEN=
# Only used when running Python directly. Compose supplies its own DATABASE_URL.
DATABASE_URL=sqlite:///movie_court.sqlite3
# Use production for HTTPS deployments; development only for local HTTP.
APP_ENV=development
